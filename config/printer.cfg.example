# LLL Plus buffer — example printer.cfg snippets.
# Copy the sections below into your own printer.cfg (or include this file),
# then replace the serial placeholder with your board's /dev/serial/by-id path
# (ls /dev/serial/by-id/ with the board plugged in). One [mcu]+[lll_buffer]
# pair per board; uncomment the *_2 / lll2 blocks for a second lane.

# --------------------------------------------------------------------------
# MCU — one section per LLL Plus board
# --------------------------------------------------------------------------
[mcu LLL_PLUS]
serial: /dev/serial/by-id/usb-Klipper_stm32f072xb_XXXXXXXXXXXX-if00
restart_method: command

# Second board (multi-lane) — uncomment and set its own by-id path:
#[mcu LLL_PLUS_2]
#serial: /dev/serial/by-id/usb-Klipper_stm32f072xb_YYYYYYYYYYYY-if00
#restart_method: command

# --------------------------------------------------------------------------
# Persistence — REQUIRED for LLL profiles, filament declarations and
# runtime tweaks to survive restarts (they are replayed on connect).
# Skip this section if your printer.cfg already has [save_variables].
# --------------------------------------------------------------------------
[save_variables]
filename: ~/printer_data/variables.cfg

# --------------------------------------------------------------------------
# LLL buffer lanes — one section per board
# --------------------------------------------------------------------------
[lll_buffer lll]
mcu: LLL_PLUS
role: parked
#   Recommended: 'parked' closes the boot window where the compiled-in
#   default (active/auto) could push filament before Klipper's config
#   arrives. Activate the lane you want after startup with:
#   LLL_ROLE LANE=lll ROLE=active
#   Note: this covers Klipper restarts, NOT a hard MCU reset (M112 /
#   power-cycle) — avoid a tensioned arm + engaged filament during those.
#feed_mode: auto
#   Feed mode at startup: auto | semi_auto | semi_manual | manual. Default: auto.
#   Default: auto.
#enable:
#   Comma-separated functions to force ON from the config sequence,
#   e.g. enable: led, diag
#   Functions: feed, buttons, mbsig, entrance, tmc, move, diag, led,
#   adc, telem, ioext. Default: empty (compiled-in defaults).
#disable:
#   Comma-separated functions to force OFF, e.g. disable: buttons
#   Default: empty.
#poll_interval: 1.5
#   State refresh / keepalive period in seconds (0.3 - 30). Default: 1.5.
#moonraker_endpoint: ~/printer_data/comms/moonraker.sock
#   Where to push this lane's active Spoolman spool (LLL_FILAMENT SPOOL_ID=).
#   A filesystem path talks to Moonraker's Unix socket directly (JSON-RPC,
#   no network stack); an http(s):// URL uses the HTTP API instead, for a
#   setup where Moonraker isn't local or the socket lives somewhere else.
#   Default: the standard Moonraker socket path.
#event_gcode:
#   G-code template run on EVERY event pushed by the board (~20-50 ms
#   reaction). Jinja context: event.name / event.code / event.value /
#   event.lane. Example — pause the print on a jam:
#  {% if event.name == 'ecode_set' and event.value == 1 %}
#    M118 Jam on {event.lane} !
#    PAUSE
#  {% endif %}

# Second lane (multi-lane) — uncomment together with [mcu LLL_PLUS_2]:
#[lll_buffer lll2]
#mcu: LLL_PLUS_2
#role: parked

# --------------------------------------------------------------------------
# Load / unload pipeline (buffer_manager)
#
# Drives filament from the buffer to the extruder in three phases:
#   A PUSH    buffer jogs in short bounded pulses until the Roadrunner sees
#             filament. Pulsed on purpose - a continuous push overshoots and
#             buckles at any unguided gap in the path. Cold-safe.
#   B ASSIST  the extruder pulls while the buffer keeps pushing, until the
#             post-extruder switch confirms the gear actually grabbed.
#             Requires the extruder above min_extrude_temp.
#   C HANDOFF buffer returns to firmware autonomy, loaded_gcode runs.
#
# EVERY DISTANCE AND DURATION BELOW IS A PLACEHOLDER. None of it has run on
# hardware. Measure on your own machine before trusting any of it.
#
# Omit roadrunner_sensor + the toolhead switch (both, together) to fall back
# to the sensorless arm-settle heuristic instead of the three-phase pipeline.
# --------------------------------------------------------------------------
#[buffer_manager lll]
#lane: lll                  # the [lll_buffer] section this drives
#extruder: extruder         # extruder this lane's E-moves target. On a
#                           #   toolchanger this MUST name the lane's own
#                           #   extruder: loading is refused unless it is
#                           #   Klipper's active extruder, so a docked tool
#                           #   can never be driven by mistake.
#roadrunner_sensor:         # name of the [high_resolution_filament_sensor]
#                           #   before the extruder
#post_extruder_pin:         # raw switch pin after the extruder gear, OR:
#post_extruder_sensor:      # name of an existing [filament_switch_sensor]
#                           #   on that switch. Use this when the pin is
#                           #   already a runout sensor - Klipper allows
#                           #   only one owner per pin. Set one, not both.
#
#pulse_ms: 100              # Phase A pulse width. Matches the Roadrunner's
#                           #   own 100 ms refresh - sampling faster gains
#                           #   nothing.
#phase_a_stall_pulses: 10   # Phase A only: consecutive pulses with zero MDM
#                           #   movement before calling it a stall. MDM-based
#                           #   (the Roadrunner has no filament in it yet) -
#                           #   much coarser than stall_count below, since one
#                           #   MDM count is the whole mdm_mm_per_count.
#stall_mm: 0.5              # Phase B + unload retract: min Roadrunner travel
#                           #   per pulse to count as progress. NOT used by
#                           #   phase A - see phase_a_stall_pulses above.
#stall_count: 3             # Phase B + unload retract: consecutive stalled
#                           #   pulses before failing. NOT used by phase A.
#assist_mm: 30              # Phase B extruder pull distance
#assist_speed: 300          # mm/min. Borrowed from an unrelated probe move -
#                           #   almost certainly wants raising once benched.
#assist_max_pulses: 5       # Phase B: assist pulses attempted before failing
#                           #   if the toolhead switch never confirms a grab.
#phase_b_run_ms: 4000       # Phase B: fallback backend.run() bound, used only
#                           #   when phase A produced no learned feed rate.
#phase_b_timeout: 30        # Phase B: sub-budget (s), bounded by load_timeout.
#load_settle_time: 1.5      # No-sensor fallback only: how long HALL2 must
#                           #   stay obstructed before calling it arrived.
#load_timeout: 180
#event_mask: 0x2F           # Firmware telemetry mask, must include the arm
#                           #   bit (0x20) or arrival detection never fires -
#                           #   default already does. See src/buffer.c's
#                           #   TELEM(9) comment for the other event bits.
#
# --- MDM encoder scale ------------------------------------------------------
# The MDM sits on the buffer arm; the Roadrunner sits near the toolhead. They
# bracket the long reverse bowden, so comparing them reveals filament moving
# at one end but not the other - i.e. buckling INSIDE the bowden, which
# neither sensor can see alone.
#
# The firmware counts BOTH edges, so one count is half a segment cycle. Do not
# enter the vendor's "minimum detection distance" directly - that is the full
# cycle, and using it makes every MDM distance read 2x too long:
#
#   Disk         vendor distance   edges/rev   mdm_mm_per_count
#   3-segment        5.8 mm            6           2.90
#   5-segment        3.5 mm           10           1.75   <- default
#   10-segment       1.73 mm          20           0.865
#
# (Cross-check: segments x distance is constant at ~17.4 mm, the filament
# travel per disk revolution.)
#
# Resolution limit: one count is the finest movement the MDM can resolve, so
# this comparison cannot work per-pulse. It needs a rolling window long enough
# to accumulate several counts - roughly 17.5 mm of travel on the 5-segment
# disk, ~29 mm on the 3-segment.
#
# Both encoders are friction-coupled to the filament, so either can slip, and
# if they slip together the check sees nothing wrong. Treat a disagreement as
# "something is wrong somewhere", not as proof of which end failed, and keep
# the thresholds generous.
#mdm_mm_per_count: 1.75
#
# Windowed comparison, NOT per-pulse: one count is the finest movement the
# MDM can resolve, so within a single ~100 ms pulse it usually has not
# ticked at all and a per-pulse check would false-positive constantly.
# ~17.5 mm is about 10 counts on the 5-segment disk (~29 mm on 3-segment).
#differential_window_mm: 17.5
#differential_tolerance: 0.5    # fraction of the window the two ends may
#                               #   disagree by. Generous on purpose: real
#                               #   buckling shows up as near-total
#                               #   divergence, not a subtle percentage.
#differential_action: warn      # warn | error. Defaults to warn - this
#                               #   heuristic has never run on hardware,
#                               #   and a disagreement does not say WHICH
#                               #   end is at fault. Switch to error once
#                               #   you trust it on your machine.
# ----------------------------------------------------------------------------

# --------------------------------------------------------------------------
# Unload (sensor pipeline). Reverses the load: optional tip shaping (there is
# no cutter, so the tip is shaped rather than cut), then a synchronized
# retract - the extruder pulls while the buffer runs back, because an
# extruder pulling alone against the whole path slips - until the toolhead
# switch clears and then the Roadrunner does.
#
# The final margin is measured with the MDM, not the Roadrunner: once the
# tip passes the Roadrunner nothing threads its wheel, so its position can
# no longer advance. The tip is by then between the Roadrunner and the
# buffer, so the MDM is the sensor that can still see it.
#
# There is no splitter in this setup (6 lanes, 6 toolheads, 1:1), so the
# calibrated post-splitter tail upstream needed does not exist here.
# --------------------------------------------------------------------------
#tip_forming_gcode:            # runs before the retract; empty by default
#unload_pulse_mm: 2.0          # extruder retract per pulse
#unload_retract_speed: 900     # mm/min
#unload_clear_mm: 15.0         # MDM-measured final margin past the extruder
#unload_clear_pulses: 10       # hard bound on that final margin
#unload_timeout: 90
#unload_run_ms: 0              # No-sensor fallback only: bounded reverse run
#                               #   passed to LLL_RUN. 0 lets the firmware's
#                               #   own run_max_ms bound it instead.
#unloaded_gcode:
#    M117 unloaded
#unload_failed_gcode:
#    M117 unload FAILED
#
#loaded_gcode:
#    M117 filament at extruder
#load_failed_gcode:
#    M117 load FAILED
#
# The pipeline hears about arm/MDM events through lll_buffer's event_gcode
# hook, so the lane above needs this bridge line in ITS event_gcode:
#     BUFFER_LOAD_EVENT LANE=lll NAME={event.name} VALUE={event.value}

# --------------------------------------------------------------------------
# Optional: entrance runout -> pause the print
# The firmware already stops the buffer motor locally on entrance runout
# (ENTRANCE function). This block additionally pauses the PRINT on the
# Klipper side using the same switch, exposed as a regular MCU pin.
# --------------------------------------------------------------------------
#[filament_switch_sensor lll_entrance]
#switch_pin: ^!LLL_PLUS:PB7
#pause_on_runout: True
